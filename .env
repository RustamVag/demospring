DB_NAME=demospring
DB_USER=postgres
DB_PASSWORD=123456789
DB_EXTERNAL_PORT=5433
PG_MAX_CONNECTIONS=100
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=768MB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_LOG_MIN_DURATION=1000

APP_EXTERNAL_PORT=8080
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_CONN_TIMEOUT=30000
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
FLYWAY_ENABLED=true
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SPRING=INFO

LIQUIBASE_ENABLED=true
LIQUIBASE_CHANGELOG=classpath:db/changelog/db.changelog-master.yaml
LIQUIBASE_CONTEXTS=
LIQUIBASE_SCHEMA=

JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC